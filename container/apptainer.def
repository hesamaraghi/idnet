Bootstrap: docker
From: ubuntu:22.04

%post
    apt-get update && apt-get install -y \
        curl \
        ca-certificates \
        git \
        build-essential \
        python3 \
        python3-venv \
        vim \
     && apt-get clean

    # Install Pixi
    curl -fsSL https://pixi.sh/install.sh | bash

%environment
    export PATH="$HOME/.pixi/bin:$PATH"
